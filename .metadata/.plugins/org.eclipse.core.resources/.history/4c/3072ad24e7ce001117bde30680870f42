package Test;

import org.openqa.selenium.By;
import org.testng.Assert;
import org.testng.annotations.Test;

import Base.BaseTest;

public class OrderSummaryTest extends BaseTest{
	
	
	@Test
    public void VerifyOrderSummary() {

        // Login to SauceDemo
        driver.findElement(By.id("user-name")).sendKeys("standard_user");

        driver.findElement(By.id("password")).sendKeys("secret_sauce");

        driver.findElement(By.id("login-button")).click();

        // Add product to cart
        driver.findElement(By.id("add-to-cart-sauce-labs-backpack")).click();

        // Open shopping cart
        driver.findElement(By.className("shopping_cart_link")).click();

        // Click checkout
        driver.findElement(By.id("checkout")).click();

        // Enter checkout information
        driver.findElement(By.id("first-name"))
              .sendKeys("Shameema");

        driver.findElement(By.id("last-name"))
              .sendKeys("thasnim");

        driver.findElement(By.id("postal-code"))
              .sendKeys("680001");

        // Continue to order summary
        driver.findElement(By.id("continue")).click();

        // Verify order summary page
        String pageTitle = driver.findElement(
            By.className("title")
        ).getText();

        Assert.assertEquals(pageTitle,"Checkout: Overview","Order summary page is not displayed");

        // Verify item total
        String itemTotal = driver.findElement(By.className("summary_subtotal_label")).getText();

        Assert.assertEquals(itemTotal,"Item total: $29.99","Item total is incorrect");

        // Verify tax is displayed
        Assert.assertTrue(driver.findElement(By.className("summary_tax_label")).isDisplayed(),"Tax information is not displayed");

        // Verify total amount is displayed
        Assert.assertTrue(driver.findElement(By.className("summary_total_label")).isDisplayed(),"Total amount is not displayed");
    }
}

