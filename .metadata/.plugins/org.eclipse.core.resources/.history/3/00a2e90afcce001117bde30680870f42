 package Test;

import org.openqa.selenium.By;
import org.testng.Assert;
import org.testng.annotations.Test;

import Base.BaseTest;

public class RestAppStateTest extends BaseTest {
	
	

	    @Test
	    public void verifyResetAppState() {

	        // Login
	        driver.findElement(By.id("user-name"))
	              .sendKeys("standard_user");

	        driver.findElement(By.id("password"))
	              .sendKeys("secret_sauce");

	        driver.findElement(By.id("login-button"))
	              .click();

	        // Add product to cart
	        driver.findElement(
	            By.id("add-to-cart-sauce-labs-backpack"))
	            .click();

	        // Verify cart badge before reset
	        String cartBefore = driver.findElement(
	            By.className("shopping_cart_badge"))
	            .getText();

	        Assert.assertEquals(cartBefore, "1");

	        // Open menu
	        driver.findElement(By.id("react-burger-menu-btn"))
	              .click();

	        // Reset application state
	        driver.findElement(By.id("reset_sidebar_link"))
	              .click();

	        // Verify cart badge is cleared
	        Assert.assertTrue(driver.findElements(By.className("shopping_cart_badge")).isEmpty(),"Cart badge should be cleared after reset");
	    }
	}


